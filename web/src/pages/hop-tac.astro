---
import BaseLayout from '../layouts/BaseLayout.astro';
import Band from '../components/Band.astro';
import CardGrid from '../components/CardGrid.astro';
import InfoCard from '../components/InfoCard.astro';
import Callout from '../components/Callout.astro';
import Button from '../components/Button.astro';
import { partners } from '../copy/partners';
import { routes } from '../lib/routes';
import { t } from '../i18n/t';

/*
 * P3 NOTE: architecture.md lists /hop-tac as "code + form" (partner lead). Until P3 builds that form, every
 * "propose a partnership" link goes to the B2B contact page. P3 replaces these hrefs with the partner form's anchor or route.
 */
const apply = routes.contact;
---
<BaseLayout title={partners.title} description={partners.subtitle}>
  <Band tone="dark" size="hero" level={1} kicker={partners.kicker} title={partners.title} subtitle={partners.subtitle} />
  <Band label={partners.kicker}>
    <CardGrid cols={3}>
      {partners.types.map((p) => <InfoCard title={p.title} subtitle={p.body} href={apply} linkLabel={t('partners.request')} />)}
    </CardGrid>
    <div class="note">
      <Callout strong>
        {partners.closing}
        <Fragment slot="actions"><Button href={apply} variant="cta">{t('partners.register')}</Button></Fragment>
      </Callout>
    </div>
  </Band>
</BaseLayout>
<style>
  .note { margin-top: var(--space-5); }
</style>
