---
/** The kicker + big title + subtitle block every inner page opens with (screens 01, 03, 05, 09 ...). */
interface Props { kicker?: string; title: string; subtitle?: string; }
const { kicker, title, subtitle } = Astro.props;
---
<div class="wrap head">
  {kicker && <p class="kicker">{kicker}</p>}
  <h1>{title}</h1>
  {subtitle && <p class="sub">{subtitle}</p>}
</div>
<style>
  .head { padding-top: var(--space-5); padding-bottom: var(--space-5); }
  .kicker { color: var(--color-brand); font-weight: var(--weight-semibold); text-transform: uppercase; letter-spacing: 0.01em; }
  h1 { font-size: var(--text-3xl); color: var(--color-ink); margin-top: var(--space-2); }
  .sub { color: var(--color-muted); font-size: var(--text-lg); margin-top: var(--space-2); }
</style>
