---
/** Status badges from the designer's screens. `tone` picks the colours; text comes from the caller via t(). */
interface Props { tone: 'provisional' | 'pending' | 'new' | 'hot'; size?: 'md' | 'sm'; }
const { tone, size = 'md' } = Astro.props;
---
<span class:list={['badge', tone, size]}><slot /></span>
<style>
  .badge { display: inline-block; border-radius: var(--radius-pill); font-weight: var(--weight-bold); letter-spacing: 0.02em; white-space: nowrap; }
  .md { padding: var(--space-2) var(--space-4); font-size: var(--text-base); }
  .sm { padding: 2px var(--space-3); font-size: var(--text-xs); }
  .provisional { background: var(--color-badge-provisional-bg); color: var(--color-badge-provisional-fg); }
  .pending { background: var(--color-badge-pending-bg); color: var(--color-badge-pending-fg); }
  .new { background: var(--color-badge-new); color: var(--color-on-dark); border-radius: var(--radius-sm); }
  .hot { background: var(--color-badge-hot); color: var(--color-on-dark); border-radius: var(--radius-sm); }
</style>
