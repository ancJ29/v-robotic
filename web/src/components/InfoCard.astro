---
/**
 * The bordered white card of screens 05, 06 and 08: a title, an optional subtitle and body, an optional number badge
 * and an optional link. `href` + `linkLabel` together make the link; either alone prints nothing.
 * `accent` paints the number red (the screens do this for 01 on Services).
 */
interface Props { title: string; subtitle?: string; body?: string; index?: number; accent?: boolean; href?: string; linkLabel?: string; }
const { title, subtitle, body, index, accent = false, href, linkLabel } = Astro.props;
---
<article class="card">
  <header>
    {index !== undefined && <span class:list={['num', { accent }]}>{String(index).padStart(2, '0')}</span>}
    <div>
      <h3>{title}</h3>
      {subtitle && <p class="sub">{subtitle}</p>}
    </div>
  </header>
  {body && <p class="body">{body}</p>}
  {href && linkLabel && <a class="link" href={href}>{linkLabel} →</a>}
</article>
<style>
  .card { background: var(--color-page); border: 2px solid var(--color-line); border-radius: var(--radius-md); padding: var(--space-5);
    display: flex; flex-direction: column; gap: var(--space-4); box-shadow: var(--shadow-card); }
  header { display: flex; gap: var(--space-3); align-items: flex-start; }
  .num { flex: none; background: var(--color-brand); color: var(--color-on-dark); border-radius: var(--radius-sm);
    min-width: 2.5rem; padding: var(--space-1) var(--space-3); text-align: center; font-weight: var(--weight-bold); font-size: var(--text-lg); }
  .num.accent { background: var(--color-cta); }
  h3 { font-size: var(--text-xl); }
  .sub { color: var(--color-muted); font-size: var(--text-lg); margin-top: var(--space-1); }
  .body { color: var(--color-ink); }
  .link { margin-top: auto; font-weight: var(--weight-bold); }
</style>
