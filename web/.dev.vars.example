# Copy to .dev.vars (git-ignored) for local Cloudflare runs, and set the same names in Cloudflare Pages
# (Settings > Variables and Secrets). Placeholders only: never commit a real value.

# Spam check. Defaults below are Cloudflare's documented TEST keys (always pass); the real keys arrive at deploy (P4).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Build-time, public (it is printed into the page): the widget's site key. Unset = the always-passes test key.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Notification: a Slack incoming webhook. Leave empty to run with no notifier (the lead is still stored).
SLACK_WEBHOOK_URL=

# The R2 bucket is a binding, not a variable: bind a bucket to the name LEADS in the Pages project.

# Publish relay (/api/rebuild, piece P7). Real values are Pages secrets; never commit them.
REBUILD_HOOK_SECRET=
GITHUB_DISPATCH_TOKEN=
