{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": ".",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["config", "src", "src/**/*.json", "types"],
  "exclude": ["node_modules", "build", "dist", ".strapi", ".tmp", "src/admin"]
}
